<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback 配置（同时被 S01 main 和 SpringApplication.run 加载）

  特点：
  - root WARN，主线 INFO（业务日志可见、第三方安静）
  - HTTP debug：传 -Djooj.log.http=DEBUG
      java -Djooj.log.http=DEBUG -cp ... com.xilidou.jooj.S01
  - 格式简洁：HH:mm:ss + level + logger 类名 + msg
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level [%logger{0}] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 默认级别：第三方库（OkHttp / Jackson / Spring）只看 WARN+ -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- 主线代码：INFO 级别 -->
    <logger name="com.xilidou.jooj" level="DEBUG"/>

    <!-- s21 Demo 16.7：fork 进 jooj 的 OpenClaw weixin SDK 默认也走 INFO，
         让 [weixin-http] 入参出参日志能输出。原本走 root WARN 就被过滤掉了。 -->
    <logger name="cn.langchat.openclaw" level="INFO"/>

    <!--
      HTTP 层：默认继承上面的 INFO，但允许通过 -Djooj.log.http=DEBUG 切到 DEBUG。
      - 没设 -Djooj.log.http 时，${...:-INFO} 默认 INFO
      - 设了 -Djooj.log.http=DEBUG 时，会打印 Anthropic 请求体
    -->
    <logger name="com.xilidou.jooj.harness.http" level="${jooj.log.http:-INFO}"/>

</configuration>

