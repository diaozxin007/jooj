<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback 配置（同时被 S01 main 和 SpringApplication.run 加载）

  特点：
  - root WARN，主线 INFO（业务日志可见、第三方安静）
  - HTTP debug：传 -Dmarvis.log.http=DEBUG
      java -Dmarvis.log.http=DEBUG -cp ... com.xilidou.marvis.S01
  - 格式简洁：HH:mm:ss + level + logger 类名 + msg
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level [%logger{0}] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 默认级别：第三方库（OkHttp / Jackson / Spring）只看 WARN+ -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- 主线代码：INFO 级别 -->
    <logger name="com.xilidou.marvis" level="INFO"/>

    <!--
      HTTP 层：默认继承上面的 INFO，但允许通过 -Dmarvis.log.http=DEBUG 切到 DEBUG。
      - 没设 -Dmarvis.log.http 时，${...:-INFO} 默认 INFO
      - 设了 -Dmarvis.log.http=DEBUG 时，会打印 Anthropic 请求体
    -->
    <logger name="com.xilidou.marvis.harness.http" level="${marvis.log.http:-INFO}"/>

</configuration>

