<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.xilidou</groupId>
    <artifactId>jooj</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>jooj</name>
    <description>jooj</description>
    <url/>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Boot Web Starter — 让 jooj 可选地以 Web 模式启动。
             不引会强制 web 化:启动逻辑用 spring.main.web-application-type=none
             或 web 控制(JoojApplication 默认 NONE = CLI 模式),只有在 web profile
             或 spring.main.web-application-type=servlet 时才起 Tomcat。
             Spring Boot 4 的 WebApplicationType.NONE 即使引了 starter-web 也不会启动 servlet,
             所以引入此依赖是安全的——不影响 CLI 默认行为。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Jackson 2.x（com.fasterxml.jackson.*）
             ⚠️ Spring Boot 4.1 默认用 Jackson 3.x（tools.jackson.*），与我们代码 import 不兼容。
             显式声明 jackson-databind 2.x 优先，强制覆盖。
             这里只引 databind，它会自动传递 jackson-annotations 和 jackson-core。
             Jackson 2.18 是当前 2.x 稳定版（2026 年）。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.2</version>
        </dependency>

        <!-- jackson-datatype-jsr310: 让 ObjectMapper 序列化 java.time.Instant 等
             Java 8 日期时间类型。Session 有 Instant 字段需要这个。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.18.2</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

<!--        <dependency>-->
<!--            <groupId>com.anthropic</groupId>-->
<!--            <artifactId>anthropic-java</artifactId>-->
<!--            <version>2.42.0</version>-->
<!--        </dependency>-->

        <!-- Source: https://mvnrepository.com/artifact/com.squareup.okhttp3/okhttp -->
        <!-- 用 4.12.0 而不是 5.x，因为 5.x 是 Kotlin Multiplatform，主 jar 是空的，
             需要额外引 okhttp-jvm。4.12.0 是稳定版单 jar，包名 okhttp3 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
            <version>5.4.0</version>
        </dependency>

        <!-- 切片 C 之后:dotenv-java 已删除。
             配置走 application.yml + Spring Boot 4 的
             spring.config.import=optional:file:.env[.properties] 内置支持。
             用户原有的 .env 改成 KEY=value(无 quotes) 仍能被读取。 -->

        <!-- s19: MCP 官方 Java SDK(io.modelcontextprotocol.sdk:mcp).
             不依赖 Spring,纯 JDK 17+,跟 Boot 4.1 兼容。
             带宽:transitively 引入 jackson 3.x(tools.jackson.*)+ reactor-core 3.7。
             跟 jooj 现有 jackson 2.x(com.fasterxml.jackson.*)不同包名,可共存,
             classpath +5MB 左右。
             该 SDK 官方提供 stdio / streamable-http / sse 三种 transport,
             jooj 当前只用 stdio(子进程)实现外部 server 接入。 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>2.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot 4 把 web 相关测试 autoconfigure 拆出独立 module。
             带来 @AutoConfigureMockMvc + WebMvcTest 等(原 spring-boot-test-autoconfigure
             里的内容)。仅 test scope,不影响 main。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- mockito-core 已通过 spring-boot-starter-test 传递引入,显式声明仅作可见性提示。
             切片 C-step6 把 MockAnthropicClient 退役为 @MockBean + Mockito.when(...)。 -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- s21 Demo 16: 原本依赖的 cn.langchat.openclaw:openclaw-weixin-sdk:0.1.1 已经 fork 进
             src/main/java/cn/langchat/openclaw/weixin/(50 个文件,~3700 行,从 Maven Central
             的 -sources.jar 直接拿真源码 + 修了已知 immutable list bug)。
             详见笔记 [[jooj_改造日志_s21]] Demo 16。 -->

        <!-- s21 Demo 25: SQLite + FTS5 for cross-session full-text search.
             3.47.2.0 是 Java 17 兼容的稳定版,jar 内置 macOS arm64 + linux x86_64/arm64 +
             win x86_64 的 native lib(zero-config 解压到 tmpdir 加载)。
             不引 spring-boot-starter-jdbc —— FTS5 SQL 本身就是 SQLite 特有
             (CREATE VIRTUAL TABLE USING fts5 / MATCH ? / snippet()),
             JdbcTemplate 救不了几行代码反而让 SearchStore 强依赖 Spring 跟其他 Store 不一致。
             SearchStore 走纯 JDBC + 单连接 + WAL 模式,跟 SessionStore / TaskStore / MemoryStore
             "测试可以 new 不依赖容器" 的惯例一致。 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.47.2.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <!--
                      s23 P8.1: enable-native-access=ALL-UNNAMED 消除 sqlite-jdbc / okhttp
                      的 "Restricted method has been called" JVM warning(JDK 22+ 严格),
                      否则会污染 stderr。
                      Banner 通过 spring.main.banner-mode=off 在 application.yml 里关。
                    -->
                    <jvmArguments>--enable-native-access=ALL-UNNAMED</jvmArguments>
                </configuration>
            </plugin>
            <!-- Surefire: JOOJ_HOME 指向项目内 .jooj-test/,
                 让 sessions / cron / memory 等 ~/.jooj 衍生目录都隔离在测试目录,
                 不污染开发者真实 ~/.jooj/。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <JOOJ_HOME>${project.build.directory}/.jooj-test</JOOJ_HOME>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      s24 native image profile。激活方式:mvn -Pnative package。
      Spring Boot 4.1 内建 AOT 引擎会自动为 @Configuration / @Bean / @EventListener /
      @Scheduled / @JsonTypeInfo 生成 reachability hint,不需要手写大部分 spring beans。
    -->
    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <configuration>
                            <buildArgs>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>--no-fallback</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
